{
  "productName": "DeepGWT",
  "version": "10.7.0",
  "identifier": "br.com.deepgwt.instalador",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5710",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "title": "DeepGWT", "width": 1180, "height": 780, "minWidth": 420, "minHeight": 560 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns", "icons/icon.ico",
      "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"
    ],
    "resources": {
      "resources/deepgwt.apk": "resources/deepgwt.apk",
      "resources/shizuku.apk": "resources/shizuku.apk",
      "resources/shizuku-starter": "resources/shizuku-starter",
      "../../NOTICE": "legal/NOTICE",
      "../../LICENSE": "legal/LICENSE",
      "../../THIRD_PARTY_LICENSES.md": "legal/THIRD_PARTY_LICENSES.md"
    }
  }
}
