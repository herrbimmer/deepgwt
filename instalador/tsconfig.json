{
  // Só checagem de tipos (`tsc` no build); quem gera o pacote é o Vite.
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }],
  "compilerOptions": {
    "jsx": "react-jsx", "target": "ES2020", "module": "ESNext", "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler", "resolveJsonModule": true, "allowImportingTsExtensions": true,
    "isolatedModules": true, "useDefineForClassFields": true, "skipLibCheck": true, "noEmit": true,
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true, "noFallthroughCasesInSwitch": true
  }
}
