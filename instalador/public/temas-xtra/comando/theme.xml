<theme>
    <name>Centro de Comando</name>
    <description>Sala de controle: cinco painéis emoldurados em fonte mono. À esquerda, a velocidade com gráfico do último minuto de verdade — o tema guarda o histórico e desenha a linha; no meio, o giro em colunas que ficam vermelhas depois de 6.000; à direita, dois tubos de reserva com tensão, corrente e nível de recuperação. Embaixo, doze lâmpadas de sistema e uma tabela de telemetria com dez leituras.</description>
    <version>1.2.1</version>
    <minBridgeVersion>1.0.0</minBridgeVersion>
    <contractVersion>v1.0</contractVersion>
    <thumbnail>thumbnail.png</thumbnail>
    <mainFile>app.html</mainFile>
    <!-- Tela cheia do painel: o tema é opaco e cobre os mostradores nativos por cima,
         mesma estratégia do Default e do Bavarian ID7 (sem <nativeMasks>). -->
    <AppDefaultPosition>
        <x>0</x>
        <y>0</y>
        <width>1920</width>
        <height>720</height>
    </AppDefaultPosition>
    <!-- Preferência do próprio tema (não é telemetria): lida no carregamento com
         Android.getPreference('displayMode','Dia') e reaplicada a cada 2s pelo núcleo,
         sem recarregar a página. -->
    <configurations>
        <configuration>
            <id>display_mode</id>
            <label>Modo de Exibição</label>
            <type>combo</type>
            <options>Dia, Noite</options>
            <default>Dia</default>
            <stateVariable>displayMode</stateVariable>
            <group>Geral</group>
        </configuration>
    </configurations>
</theme>
