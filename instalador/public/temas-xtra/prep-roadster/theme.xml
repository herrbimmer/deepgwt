<theme>
    <name>Preparador Roadster</name>
    <description>O conversível de série curta daquela oficina: dois mostradores de 150 px baixos, na altura do capô, e o resto da tela deixado vazio de propósito -- no carro aberto quem ocupa o campo de visão é o mundo, não o painel. Uma linha de horizonte fina atravessa a tela e as temperaturas de fora e da cabine ficam logo abaixo da assinatura.</description>
    <version>1.2.0</version>
    <minBridgeVersion>1.0.0</minBridgeVersion>
    <contractVersion>v1.0</contractVersion>
    <thumbnail>thumbnail.png</thumbnail>
    <mainFile>app.html</mainFile>
    <!-- Tela cheia do painel: o tema é opaco e cobre os mostradores nativos por cima,
         mesma estratégia do Default e do Bavarian ID7 (sem <nativeMasks>). -->
    <AppDefaultPosition>
        <x>0</x>
        <y>0</y>
        <width>1920</width>
        <height>720</height>
    </AppDefaultPosition>
    <!-- Preferência do próprio tema (não é telemetria): lida no carregamento com
         Android.getPreference('displayMode','Dia') e reaplicada a cada 2s pelo núcleo,
         sem recarregar a página. -->
    <configurations>
        <configuration>
            <id>display_mode</id>
            <label>Modo de Exibição</label>
            <type>combo</type>
            <options>Dia, Noite</options>
            <default>Dia</default>
            <stateVariable>displayMode</stateVariable>
            <group>Geral</group>
        </configuration>
    </configurations>
</theme>
