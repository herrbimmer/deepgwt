<theme>
    <name>Fósforo</name>
    <description>Mostrador fluorescente a vácuo, verde de fósforo sobre preto absoluto: o segmento apagado não some, ele só perde o brilho, e o aceso espalha halo. A barra de giro atravessa a tela inteira em quarenta segmentos inclinados que viram âmbar na zona vermelha, e quatro colunas verticais à direita fazem tanque, bateria, tensão e temperatura -- o arranjo dos cupês americanos de carroceria em fibra do começo dos anos 80.</description>
    <version>1.2.0</version>
    <minBridgeVersion>1.0.0</minBridgeVersion>
    <contractVersion>v1.0</contractVersion>
    <thumbnail>thumbnail.png</thumbnail>
    <mainFile>app.html</mainFile>
    <!-- Tela cheia do painel: o tema é opaco e cobre os mostradores nativos por cima,
         mesma estratégia do Default e do Bavarian ID7 (sem <nativeMasks>). -->
    <AppDefaultPosition>
        <x>0</x>
        <y>0</y>
        <width>1920</width>
        <height>720</height>
    </AppDefaultPosition>
    <!-- Preferência do próprio tema (não é telemetria): lida no carregamento com
         Android.getPreference('displayMode','Dia') e reaplicada a cada 2s pelo núcleo,
         sem recarregar a página. -->
    <configurations>
        <configuration>
            <id>display_mode</id>
            <label>Modo de Exibição</label>
            <type>combo</type>
            <options>Dia, Noite</options>
            <default>Dia</default>
            <stateVariable>displayMode</stateVariable>
            <group>Geral</group>
        </configuration>
    </configurations>
</theme>
