<theme>
    <name>Cinco Mostradores</name>
    <description>Cinco mostradores sobrepostos como num esportivo clássico: conta-giros grande no centro, velocímetro à esquerda, mostrador combinado de combustível e bateria à direita com dois ponteiros concêntricos, e dois pequenos nas pontas para temperatura externa e consumo. Faces pretas com numeração marfim, aros cromados duplos e ponteiros de ponta laranja; embaixo, as pastilhas P R N D e uma janela com velocidade, hodômetro e hora.</description>
    <version>1.2.0</version>
    <minBridgeVersion>1.0.0</minBridgeVersion>
    <contractVersion>v1.0</contractVersion>
    <thumbnail>thumbnail.png</thumbnail>
    <mainFile>app.html</mainFile>
    <!-- Tela cheia do painel: o tema é opaco e cobre os mostradores nativos por cima,
         mesma estratégia do Default e do Bavarian ID7 (sem <nativeMasks>). -->
    <AppDefaultPosition>
        <x>0</x>
        <y>0</y>
        <width>1920</width>
        <height>720</height>
    </AppDefaultPosition>
    <!-- Preferência do próprio tema (não é telemetria): lida no carregamento com
         Android.getPreference('displayMode','Dia') e reaplicada a cada 2s pelo núcleo,
         sem recarregar a página. -->
    <configurations>
        <configuration>
            <id>display_mode</id>
            <label>Modo de Exibição</label>
            <type>combo</type>
            <options>Dia, Noite</options>
            <default>Dia</default>
            <stateVariable>displayMode</stateVariable>
            <group>Geral</group>
        </configuration>
    </configurations>
</theme>
