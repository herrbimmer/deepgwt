<theme>
    <name>Jornal</name>
    <description>Primeira página: mastro &#x27;O PAINEL&#x27; entre filetes, linha de data com hora e temperatura, manchete com a velocidade escrita por extenso em 118px, olho em itálico e quatro colunas separadas por fio — combustível, eletricidade, motor e cabine. Um boxe de filete duplo traz a quilometragem, e o rodapé é a coluna social: o que está tocando e a velocidade soletrada.</description>
    <version>1.2.0</version>
    <minBridgeVersion>1.0.0</minBridgeVersion>
    <contractVersion>v1.0</contractVersion>
    <thumbnail>thumbnail.png</thumbnail>
    <mainFile>app.html</mainFile>
    <!-- Tela cheia do painel: o tema é opaco e cobre os mostradores nativos por cima,
         mesma estratégia do Default e do Bavarian ID7 (sem <nativeMasks>). -->
    <AppDefaultPosition>
        <x>0</x>
        <y>0</y>
        <width>1920</width>
        <height>720</height>
    </AppDefaultPosition>
    <!-- Preferência do próprio tema (não é telemetria): lida no carregamento com
         Android.getPreference('displayMode','Dia') e reaplicada a cada 2s pelo núcleo,
         sem recarregar a página. -->
    <configurations>
        <configuration>
            <id>display_mode</id>
            <label>Modo de Exibição</label>
            <type>combo</type>
            <options>Dia, Noite</options>
            <default>Dia</default>
            <stateVariable>displayMode</stateVariable>
            <group>Geral</group>
        </configuration>
    </configurations>
</theme>
