<theme>
    <name>Suábio Três</name>
    <description>Três poços fundos sob um capuz único, o do meio maior: tanque à esquerda entre E e F, velocidade no centro com 216 px de raio, relógio de ponteiros à direita. É a arquitetura do sedã de Stuttgart que definiu o que era painel de carro grande por vinte anos -- anel cromado fino, numeral marfim de traço largo, agulha cor de tijolo.</description>
    <version>1.2.0</version>
    <minBridgeVersion>1.0.0</minBridgeVersion>
    <contractVersion>v1.0</contractVersion>
    <thumbnail>thumbnail.png</thumbnail>
    <mainFile>app.html</mainFile>
    <!-- Tela cheia do painel: o tema é opaco e cobre os mostradores nativos por cima,
         mesma estratégia do Default e do Bavarian ID7 (sem <nativeMasks>). -->
    <AppDefaultPosition>
        <x>0</x>
        <y>0</y>
        <width>1920</width>
        <height>720</height>
    </AppDefaultPosition>
    <!-- Preferência do próprio tema (não é telemetria): lida no carregamento com
         Android.getPreference('displayMode','Dia') e reaplicada a cada 2s pelo núcleo,
         sem recarregar a página. -->
    <configurations>
        <configuration>
            <id>display_mode</id>
            <label>Modo de Exibição</label>
            <type>combo</type>
            <options>Dia, Noite</options>
            <default>Dia</default>
            <stateVariable>displayMode</stateVariable>
            <group>Geral</group>
        </configuration>
    </configurations>
</theme>
