<theme>
    <name>Stuttgart Sport</name>
    <description>Painel esportivo: túnel vermelho no centro com a velocidade no topo e a rotação embaixo, meias-luas que enchem com o giro, escalas de bateria e potência, círculo de força G (estimada pela variação da velocidade) e círculo de consumo e temperatura da cabine. No rodapé, combustível com autonomia, hora, READY, EV, temperatura externa, barra de potência e recarga e câmbio PRND. Cor do túnel escolhível (ou seguindo o modo de condução) e modo dia/noite.</description>
    <version>1.2.0</version>
    <minBridgeVersion>1.0.0</minBridgeVersion>
    <contractVersion>v1.0</contractVersion>
    <thumbnail>thumbnail.png</thumbnail>
    <mainFile>app.html</mainFile>
    <!-- O vão da projeção: o miolo do túnel, entre as meias-luas (o tema declara a mesma caixa
         por Android.setProjectionBox). -->
    <AppDefaultPosition>
        <x>560</x>
        <y>198</y>
        <width>800</width>
        <height>392</height>
    </AppDefaultPosition>

    <!--
      Mesmas máscaras do Stuttgart Clássico: cobrem o velocímetro, o card de mídia e a
      faixa central de cima do painel de fábrica, para nada nativo aparecer por trás quando o tema
      cede a tela a uma projeção.
    -->
    <nativeMasks>
        <speedMask enabled="true" x="0" y="0" width="640" height="720" />
        <infoMask enabled="true" x="1280" y="0" width="640" height="720" />
        <topCenterMask enabled="true" x="660" y="0" width="600" height="90" />
    </nativeMasks>

    <!-- Preferências do próprio tema (não são telemetria): lidas no carregamento via
         Android.getPreference e reaplicadas a cada batida (2 s), sem recarregar a página. -->
    <configurations>
        <configuration>
            <id>display_mode</id>
            <label>Modo de Exibição</label>
            <type>combo</type>
            <options>Dia, Noite</options>
            <default>Dia</default>
            <stateVariable>displayMode</stateVariable>
            <group>Geral</group>
        </configuration>
        <configuration>
            <id>accent_mode</id>
            <label>Cor do Painel</label>
            <type>combo</type>
            <options>Vermelho, Azul, Âmbar, Seguir modo</options>
            <default>Vermelho</default>
            <stateVariable>accentMode</stateVariable>
            <group>Geral</group>
        </configuration>
    </configurations>
</theme>
