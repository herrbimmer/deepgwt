<!-- Backup automático (Android 11 e anterior). A licença (licenca.xml) nunca vai junto: restaurá-la
     em outro aparelho, ou voltar uma cópia antiga, não pode devolver horas já gastas. -->
<full-backup-content>
    <exclude domain="sharedpref" path="licenca.xml"/>
    <exclude domain="device_sharedpref" path="licenca.xml"/>
</full-backup-content>
